// prisma/schema.prisma
// UnicomTeam — company operating system
// Every model here maps to something that already exists on the site.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── USERS & STAFF ───────────────────────────────────────────────────────────
// Your 5 team members from /about live here. Role drives which dashboard you see:
// ADMIN → /admin (everything), STAFF → /dashboard (your own work).

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole[] @default([STAFF])

  title      String? // "CEO & Full-Stack Developer"
  department Department?
  phone      String?
  bio        String?
  active     Boolean     @default(true)
  joinedAt   DateTime    @default(now())

  // "Sign out everywhere": any JWT issued before this instant is rejected in
  // the jwt callback. Lets us revoke sessions without leaving the JWT strategy.
  sessionsValidFrom DateTime?

  // Notification preferences (Account tab of /admin/settings)
  notifyOnLead     Boolean @default(true)
  notifyOnPayment  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Auth
  accounts Account[]
  sessions Session[]

  // Work
  ledProjects            Project[]           @relation("ProjectLead")
  assignments            ProjectAssignment[]
  tasks                  Task[]              @relation("TaskAssignee")
  timeEntries            TimeEntry[]
  supervisedCertificates Certificate[]       @relation("CertificateSupervisor")
  handledMessages        ContactMessage[]    @relation("MessageHandler")
  confirmedPayments      Payment[]           @relation("PaymentConfirmedBy")
  activityLogs           ActivityLog[]
  uploads                Upload[]            @relation("UploadedBy")
  notifications          Notification[]

  // Wallet
  earnings        Earning[]       @relation("UserEarnings")
  decidedEarnings Earning[]       @relation("EarningDecidedBy")
  payoutRequests  PayoutRequest[] @relation("UserPayouts")
  decidedPayouts  PayoutRequest[] @relation("PayoutDecidedBy")
  shareGrants     ShareGrant[]    @relation("UserShares")
  issuedGrants    ShareGrant[]    @relation("GrantedBy")

  @@map("users")
}

enum UserRole {
  ADMIN
  STAFF
  /// Holds equity in the company. Orthogonal to ADMIN/STAFF, which control
  /// access — a partner may be either, and being one grants no extra access.
  PARTNER
}

enum Department {
  ENGINEERING // Core Engineering — Full-Stack & Systems
  DESIGN // Creative & Design — UI/UX & Brand Identity
  GROWTH // Growth Strategy — Marketing & Operations
  OPERATIONS
}

// ─── AUTH (NextAuth) ─────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── CLIENTS & PROJECTS ──────────────────────────────────────────────────────
// The 9 case studies on /projects become Project rows; the ones with real
// domains (vihipex.com, gracyglobal.com, …) also get a Client.

model Client {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  contactName String?
  email       String?
  phone       String?
  country     String?
  website     String?
  logoUrl     String?
  notes       String?
  status      ClientStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]
  invoices Invoice[]

  @@map("clients")
}

enum ClientStatus {
  LEAD
  ACTIVE
  PAST
}

model Project {
  id              String          @id @default(cuid())
  title           String
  slug            String          @unique
  category        ProjectCategory
  description     String // the card blurb shown on /projects
  longDescription String?
  tags            String[] // ["Next.js", "TypeScript", …]
  liveUrl         String?
  repoUrl         String?
  coverImage      String?

  status    ProjectStatus @default(IN_PROGRESS)
  published Boolean       @default(false) // show on the public /projects page
  featured  Boolean       @default(false)
  sortOrder Int           @default(0)

  startDate   DateTime?
  dueDate     DateTime?
  deliveredAt DateTime?

  budget   Decimal? @db.Decimal(12, 2)
  currency String   @default("XAF")

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  leadId String?
  lead   User?   @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  milestones  Milestone[]
  assignments ProjectAssignment[]
  tasks       Task[]
  timeEntries TimeEntry[]
  invoices    Invoice[]
  earnings    Earning[]

  @@index([clientId])
  @@index([status])
  @@map("projects")
}

enum ProjectCategory {
  SOFTWARE_DEVELOPMENT
  MOBILE_WEB_APP
  DIGITAL_MARKETING
  SOCIAL_MEDIA
  BUSINESS_STRATEGY
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  REVIEW
  DELIVERED
  MAINTENANCE
  ON_HOLD
  CANCELLED
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  sortOrder   Int       @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("milestones")
}

model ProjectAssignment {
  id            String   @id @default(cuid())
  projectId     String
  userId        String
  role          String? // "Frontend", "Design lead", …
  allocationPct Int? // rough % of their time

  /// Revenue share of the project budget, as a percentage. Distinct from
  /// allocationPct: one is how much of their time this takes, the other is
  /// how much of the money is theirs. Credited when the project is delivered.
  sharePct Decimal? @db.Decimal(5, 2)

  assignedAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_assignments")
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timeEntries TimeEntry[]

  @@index([assigneeId, status])
  @@index([projectId])
  @@map("tasks")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model TimeEntry {
  id     String   @id @default(cuid())
  userId String
  date   DateTime @default(now())
  hours  Decimal  @db.Decimal(5, 2)
  note   String?

  projectId String?
  taskId    String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId, date])
  @@map("time_entries")
}

// ─── SERVICES (public site content) ──────────────────────────────────────────
// Replaces the hardcoded array in app/services/data.ts.

model Service {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  desc      String
  tag       String // "Engineering", "Growth", …
  details   String[]
  icon      String? // lucide icon name, e.g. "Code"
  published Boolean  @default(true)
  sortOrder Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("services")
}

// ─── TRAINING PROGRAMS, CRASH COURSES & INTERNSHIP ROLES ─────────────────────
// One model covers all three — they share 90% of their fields on the site.

model Program {
  id          String      @id @default(cuid())
  slug        String      @unique
  kind        ProgramKind
  title       String
  subtitle    String? // "HTML · CSS · JavaScript · React"
  description String

  level          ProgramLevel?
  durationLabel  String? // "3, 6 Months"
  durationMonths Int[] // [3, 6] — machine-readable version of the above
  sessionsLabel  String? // "24 Live Sessions"
  mentorship     String? // "1-on-1 Mentorship"
  outcome        String? // "Portfolio + Certificate"
  topics         String[]

  priceFrom       Int? // 75000 (FCFA)
  registrationFee Int? // 5000 (FCFA)
  currency        String @default("XAF")
  paymentNote     String?

  // Internship-only fields
  stack    String? // "React · TypeScript · Tailwind"
  workMode WorkMode?
  slots    Int?
  paid     Boolean?

  // Presentation (kept so the public pages can render straight from the DB)
  icon         String?
  accent       String?
  accentBorder String?
  badgeText    String?

  featured  Boolean @default(false)
  published Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cohorts     Cohort[]
  enrollments Enrollment[]
  materials   ProgramMaterial[]

  @@index([kind, published])
  @@map("programs")
}

enum ProgramKind {
  TRAINING
  CRASH_COURSE
  INTERNSHIP
}

enum ProgramLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  CRASH_COURSE
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

model Cohort {
  id        String       @id @default(cuid())
  programId String
  name      String // "March 2026"
  startDate DateTime?
  endDate   DateTime?
  capacity  Int?
  status    CohortStatus @default(PLANNED)

  program     Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([programId, name])
  @@map("cohorts")
}

enum CohortStatus {
  PLANNED
  OPEN
  RUNNING
  COMPLETED
  CANCELLED
}

// ─── PEOPLE WHO APPLY / ENROLL ───────────────────────────────────────────────

model Student {
  id           String  @id @default(cuid())
  fullName     String
  email        String  @unique
  phone        String?
  country      String?
  portfolioUrl String?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments  Enrollment[]
  certificates Certificate[]

  @@map("students")
}

model Enrollment {
  id        String         @id @default(cuid())
  reference String         @unique // UCT-ENR-2026-0001
  type      EnrollmentType
  status    EnrollmentStatus @default(NEW)

  // Applicant snapshot — kept even if the Student record is later edited
  fullName     String
  email        String
  phone        String
  country      String
  portfolioUrl String?

  // What they applied for
  programId   String?
  courseName  String // raw label from the form, always populated
  category    String?
  level       String? // "Complete Beginner", …
  months      Int?
  cohortLabel String? // free-text "preferred start" from the form
  cohortId    String?
  goals       String?

  // Money as shown on the form (labels), plus parsed amounts
  plan                PaymentPlan @default(FULL)
  priceLabel          String?
  registrationFeeLabel String?
  priceAmount         Int?
  registrationFee     Int?
  paymentNote         String?

  // Delivery of the confirmation email
  emailSent  Boolean   @default(false)
  emailError String?
  emailSentAt DateTime?

  source    String? @default("website")
  adminNotes String?

  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  program   Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  cohort    Cohort?  @relation(fields: [cohortId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments    Payment[]
  certificate Certificate?

  @@index([status, createdAt])
  @@index([email])
  @@map("enrollments")
}

enum EnrollmentType {
  TRAINING
  INTERNSHIP
}

enum EnrollmentStatus {
  NEW
  CONTACTED
  INTERVIEW
  ACCEPTED
  PAID
  ENROLLED
  ACTIVE
  COMPLETED
  REJECTED
  WITHDRAWN
}

enum PaymentPlan {
  FULL
  INSTALLMENTS
}

// ─── CERTIFICATES (/verify) ──────────────────────────────────────────────────
// Replaces the hardcoded array in lib/certificates.ts.

model Certificate {
  id     String            @id @default(cuid())
  certNo String            @unique // UCT-INT-2026-0015
  type   CertificateType
  status CertificateStatus @default(VALID)

  name       String // holder name, denormalized so old certs never change
  program    String // "Full Stack Development Internship"
  department String

  periodStart DateTime
  periodEnd   DateTime
  dateIssued  DateTime

  supervisorName  String
  supervisorTitle String
  supervisorId    String?
  supervisor      User?   @relation("CertificateSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)

  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  enrollmentId String?     @unique
  enrollment   Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  // Signed PDF of the certificate, in the private bucket. Read through
  // /api/uploads/download — never a permanent public URL.
  fileId String?
  file   Upload? @relation("CertificateFile", fields: [fileId], references: [id], onDelete: SetNull)

  revokedAt     DateTime?
  revokedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  verifications CertificateVerification[]

  @@index([status])
  @@map("certificates")
}

enum CertificateType {
  INTERNSHIP
  TRAINING
  CRASH_COURSE
}

enum CertificateStatus {
  VALID
  REVOKED
}

// Every /verify lookup, so you can see who is checking your certificates.
model CertificateVerification {
  id            String   @id @default(cuid())
  certNo        String
  found         Boolean
  certificateId String?
  ip            String?
  userAgent     String?
  createdAt     DateTime @default(now())

  certificate Certificate? @relation(fields: [certificateId], references: [id], onDelete: SetNull)

  @@index([certNo])
  @@map("certificate_verifications")
}

// ─── MONEY ───────────────────────────────────────────────────────────────────

model Invoice {
  id     String        @id @default(cuid())
  number String        @unique // UCT-INV-2026-0001
  status InvoiceStatus @default(DRAFT)

  clientId  String?
  projectId String?

  issueDate DateTime  @default(now())
  dueDate   DateTime?

  currency String  @default("XAF")
  subtotal Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  notes String?

  client  Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    InvoiceItem[]
  payments Payment[]

  @@index([status])
  @@map("invoices")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  VOID
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)
  sortOrder   Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

// Covers both student MoMo payments and client invoice payments.
model Payment {
  id        String        @id @default(cuid())
  reference String?
  amount    Decimal       @db.Decimal(12, 2)
  currency  String        @default("XAF")
  method    PaymentMethod @default(MOMO)
  status    PaymentStatus @default(PENDING)
  kind      PaymentKind   @default(TUITION)

  payerName   String?
  momoNumber  String?
  note        String?
  paidAt      DateTime?
  confirmedAt DateTime?

  confirmedById String?
  confirmedBy   User?   @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)

  enrollmentId String?
  invoiceId    String?

  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  invoice    Invoice?    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@map("payments")
}

enum PaymentMethod {
  MOMO // MTN Mobile Money
  ORANGE_MONEY
  BANK_TRANSFER
  CASH
  CARD
  OTHER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

enum PaymentKind {
  REGISTRATION_FEE
  TUITION
  INSTALLMENT
  PROJECT_PAYMENT
  OTHER
}

// ─── CONTACT / INBOUND LEADS ─────────────────────────────────────────────────

model ContactMessage {
  id      String     @id @default(cuid())
  name    String
  email   String
  phone   String?
  subject String?
  service String? // which service they asked about
  message String
  status  LeadStatus @default(NEW)

  handledById String?
  handledBy   User?   @relation("MessageHandler", fields: [handledById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@map("contact_messages")
}

enum LeadStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

// ─── AUDIT TRAIL ─────────────────────────────────────────────────────────────

model ActivityLog {
  id       String   @id @default(cuid())
  userId   String?
  action   String // "enrollment.status_changed"
  entity   String // "Enrollment"
  entityId String?
  meta     Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

// ─── ORG SETTINGS ────────────────────────────────────────────────────────────
// Single-row-per-key store. Values that used to be hardcoded in the source
// (the MoMo number on /admin/payments, reference prefixes) live here so they
// can be changed without a deploy. Read through lib/settings.ts, which applies
// defaults for any key that has never been written.

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ─── FILE UPLOADS (Cloudflare R2) ──────────────────────────────────────────
// One row per object in R2. Without this there is no way to list what exists,
// find orphans after a record is deleted, or read a private file — private
// objects are fetched by key, and a bare URL column cannot hold one.
//
// `confirmed` is false between issuing a presigned URL and the browser
// reporting success, so abandoned uploads are identifiable and sweepable.

model Upload {
  id          String  @id @default(cuid())
  key         String  @unique // object key within the bucket
  bucket      String
  category    String // avatars | projects | certificates | materials
  visibility  String // public | private
  filename    String // original name, for display
  contentType String
  size        Int // bytes
  url         String? // permanent CDN URL; null for private objects
  confirmed   Boolean @default(false)

  uploadedById String?
  uploadedBy   User?   @relation("UploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  materials    ProgramMaterial[]
  certificates Certificate[]     @relation("CertificateFile")

  @@index([category, createdAt])
  @@index([confirmed])
  @@map("uploads")
}

// ─── STAFF WALLET ──────────────────────────────────────────────────────────
// A ledger, not a balance column. Balances are derived by summing rows, so
// there is no single number that can silently drift out of step with the
// history behind it.
//
//   available = credited earnings − (paid payouts + payouts in flight)

model Earning {
  id     String @id @default(cuid())
  userId String

  projectId String?
  source    EarningSource @default(PROJECT_SHARE)
  status    EarningStatus @default(CREDITED)

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("XAF")

  /// The percentage this was calculated from, snapshotted at credit time.
  /// Kept so changing an assignment later never rewrites past earnings.
  sharePct Decimal? @db.Decimal(5, 2)

  /// "YYYY-MM" on a MONTHLY claim, null on everything else. Stored as text
  /// rather than a date because the month *is* the identity here — there is no
  /// meaningful day, and a date would invite timezone drift across a boundary.
  periodMonth String?

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Who approved or rejected it, and when. Null while still PENDING, and on
  /// anything credited directly without passing through approval.
  decidedById String?
  decidedAt   DateTime?

  user      User     @relation("UserEarnings", fields: [userId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  decidedBy User?    @relation("EarningDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  /// One project share per person per project — makes crediting on delivery
  /// idempotent, so re-saving a delivered project cannot pay someone twice.
  /// It covers PROJECT_FEE too: a person has at most one fee claim per project,
  /// so resubmitting after a rejection revises that row rather than stacking.
  @@unique([projectId, userId, source])
  /// The same guarantee for monthly pay: one claim per person per month.
  /// Rows with a null periodMonth are unaffected — Postgres treats nulls as
  /// distinct, so bonuses and adjustments are not constrained by this.
  @@unique([userId, source, periodMonth])
  @@index([userId, status])
  @@index([status, createdAt])
  @@map("earnings")
}

enum EarningSource {
  /// Legacy: a percentage of a project budget, credited on delivery.
  PROJECT_SHARE
  /// A flat amount claimed for one project, paid once an admin approves.
  PROJECT_FEE
  /// A flat amount claimed for one month, paid once an admin approves.
  MONTHLY
  BONUS
  ADJUSTMENT
}

enum EarningStatus {
  /// Claimed but not approved. Counts toward nothing — see getWallet.
  PENDING
  CREDITED
  CANCELLED
}

model PayoutRequest {
  id     String @id @default(cuid())
  userId String

  amount   Decimal      @db.Decimal(12, 2)
  currency String       @default("XAF")
  status   PayoutStatus @default(REQUESTED)

  method      PaymentMethod @default(MOMO)
  destination String? // MoMo number to send to
  note        String?
  reference   String? // transaction reference once sent

  requestedAt DateTime  @default(now())
  decidedAt   DateTime?
  paidAt      DateTime?

  decidedById String?

  user      User  @relation("UserPayouts", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("PayoutDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, requestedAt])
  @@map("payout_requests")
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  PAID
  REJECTED
}

// ─── EQUITY ──────────────────────────────────────────────────────────────
// Company shares, distinct from ProjectAssignment.sharePct: equity is a
// standing stake in the business, a project share is payment for one job.
// Someone can hold both, or either, or neither.
//
// A ledger of grants rather than a shares-held column — same reasoning as the
// wallet. Someone's holding is the sum of their grants, so every change to a
// cap table leaves a trace of who did it and why. Negative grants record a
// buyback or forfeit.

model ShareGrant {
  id     String @id @default(cuid())
  userId String

  /// Negative for a buyback or forfeit.
  shares Int
  note   String?

  grantedById String?
  createdAt   DateTime @default(now())

  user      User  @relation("UserShares", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("GrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("share_grants")
}

// A file attached to a training programme — slides, exercises, recordings.
model ProgramMaterial {
  id          String  @id @default(cuid())
  programId   String
  uploadId    String
  title       String
  description String?
  sortOrder   Int     @default(0)

  /// When true, only enrolled students may request a download link.
  studentsOnly Boolean @default(true)

  createdAt DateTime @default(now())

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  upload  Upload  @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([programId, sortOrder])
  @@map("program_materials")
}

// ─── NOTIFICATIONS ────────────────────────────────────────────────────────────
// In-app notifications — project assignments, claim decisions, task assignments.

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info") // info, success, warning, error
  read      Boolean  @default(false)
  link      String?  // e.g. "/dashboard" or "/dashboard/wallet"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}
